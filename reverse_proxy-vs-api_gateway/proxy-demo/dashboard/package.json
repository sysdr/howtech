{
  "name": "proxy-demo-dashboard",
  "version": "1.0.0",
  "description": "Dashboard for proxy demo",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./public/input.css -o ./public/tailwind.css --minify",
    "build:js": "npx babel public/app.js --out-file public/app.compiled.js --presets=@babel/preset-react"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.28.5",
    "@babel/preset-react": "^7.23.0",
    "tailwindcss": "^3.4.0"
  }
}
